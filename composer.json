{
    "name": "jeevanjoshi/laravel-audit-trail",
    "description": "Automatic model change tracking with revert capability for Laravel",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Jeevanjoshi\\LaravelAuditTrail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jeevanjoshi\\LaravelAuditTrail\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "thecrazydiamond1",
            "email": "joshijeewon18@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/http": "^10.0|^11.0",
        "illuminate/support": "^10.0|^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jeevanjoshi\\LaravelAuditTrail\\AuditTrailServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
    "test": [
        "./vendor/bin/phpunit"
    ]
}
}